{#
/**
 * @file
 * Italian recipes — full page.
 *
 * Reached through the `node--recipe--<cuisine>` suggestion that
 * flavourful_nutrition_theme_suggestions_node_alter() adds for the full view
 * mode. It extends the standard recipe page rather than restating it, so the
 * hero, spec strip, ingredients and tag row all stay in one place and this
 * file carries only what is actually specific to the cuisine.
 *
 * @see templates/content/node--recipe.html.twig
 * @see flavourful_nutrition_theme_suggestions_node_alter()
 */
#}
{% extends '@flavourful/content/node--recipe.html.twig' %}

{% block cuisine_note %}
  {{ include('flavourful:pairing-note', {
    label: 'To drink'|t,
    text: 'An Italian red with acidity to cut the richness — a young Chianti, or a Barbera.'|t,
  }, with_context = false) }}
{% endblock %}
