{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{#
  A one-item trail is always just "Home" — the path-based builder puts Home
  first and never appends the current page. That is a <nav> landmark whose only
  link duplicates the wordmark, so it is cluttering the landmark list to say
  nothing. Same reasoning as the empty-<aside> guard in page.html.twig.
#}
{% if breadcrumb|length > 1 %}
  <nav class="breadcrumb" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol>
    {% for item in breadcrumb %}
      <li>
        {% if item.url %}
          <a href="{{ item.url }}">{{ item.text }}</a>
        {% else %}
          {{ item.text }}
        {% endif %}
      </li>
    {% endfor %}
    </ol>
  </nav>
{% endif %}
