{#
/**
 * @file
 * Theme override to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template in this directory.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation. Will usually be
 *   "/" unless you have installed Drupal in a sub-directory.
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 * - is_admin: A flag indicating if the user has permission to access
 *   administration pages.
 *
 * Site identity:
 * - front_page: The URL of the front page. Use this instead of base_path when
 *   linking to the front page. This includes the language domain or prefix.
 *
 * Page content (in order of occurrence in the default page.html.twig):
 * - node: Fully loaded node, if there is an automatically-loaded node
 *   associated with the page and the node ID is the second argument in the
 *   page's path (e.g. node/12345 and node/12345/revisions, but not
 *   comment/reply/12345).
 *
 * Regions:
 * - page.header: Items for the header region.
 * - page.primary_menu: Items for the primary menu region.
 * - page.secondary_menu: Items for the secondary menu region.
 * - page.highlighted: Items for the highlighted content region.
 * - page.help: Dynamic help text, mostly for admin pages.
 * - page.content: The main content of the current page.
 * - page.sidebar_first: Items for the first sidebar.
 * - page.sidebar_second: Items for the second sidebar.
 * - page.footer: Items for the footer region.
 * - page.breadcrumb: Items for the breadcrumb region.
 *
 * Added by src/Hook/PageHooks.php — see that class for the cacheability of each:
 * - site_name, site_established, home_url: the masthead wordmark.
 * - utility_date, utility_date_iso: the date at the head of the utility bar.
 * - category_items, recipe_count: the cuisine strip and its tally.
 * - footer_links: the flattened footer menu.
 * - is_bleed: whether main should run edge to edge.
 *
 * Note on `{% embed ... with {...} only %}` throughout this file: `only` stops
 * this template's own context reaching the component, which matters because a
 * page-level variable sharing a name with a component prop (`attributes`,
 * `label`, `title`) would otherwise silently become that prop. The cost is that
 * the blocks below see only what the `with` map passes, so anything a block
 * needs is listed there explicitly.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessPage()
 * @see html.html.twig
 */
#}
<div class="layout-container">

  {#
    One <header> for the whole banner: the utility bar, the masthead and the
    category strip are three rows of a single site header, not three separate
    ones. Nesting them under one banner landmark is what keeps the landmark
    list short enough to be useful.
  #}
  <header class="page-header">

    {#
      The utility bar carries the date on the left and the secondary/account
      menu on the right. No `label` is passed, so it stays a plain <div> — the
      menu block inside it renders its own labelled <nav>, and wrapping that in
      a second one would nest navigation landmarks.
    #}
    {% embed 'flavourful:utility-bar' with {
      tone: 'deep',
      utility_date: utility_date,
      utility_date_iso: utility_date_iso,
      issue_line: site_established,
      secondary_menu: page.secondary_menu,
    } only %}
      {% block start %}
        {% if utility_date %}
          <time datetime="{{ utility_date_iso }}">{{ utility_date }}</time>
        {% endif %}
      {% endblock %}

      {% block center %}
        {#
          The design's issue line ("Issue forty-one · The long cook"). There is
          no issue field in this content model, so the site's own tagline stands
          in rather than a fabricated issue number.
        #}
        {{ issue_line }}
      {% endblock %}

      {% block end %}
        {{ secondary_menu }}
      {% endblock %}
    {% endembed %}

    {#
      The masthead. Layout is `inline` on a node page, where the hero needs the
      vertical space, and `centered` everywhere else.

      The primary menu fills the leading slot and whatever else is in the
      header region (a search block, say) the trailing one. The site-branding
      block is not among them: PageHooks::dropBrandingBlock() removes it,
      because the wordmark below already renders the site name.
    #}
    {% embed 'flavourful:site-masthead' with {
      site_name: site_name,
      home_url: home_url,
      established: site_established,
      layout: node ? 'inline' : 'centered',
      primary_menu: page.primary_menu,
      header_region: page.header,
    } only %}
      {% block nav_start %}
        {{ primary_menu }}
      {% endblock %}

      {% block nav_end %}
        {{ header_region }}
      {% endblock %}
    {% endembed %}

    {#
      The cuisine strip. Rendered only when PageHooks found the /recipes route
      and at least one term — an empty strip would leave a ruled band with
      nothing in it.
    #}
    {% if category_items is not empty %}
      {{ include('flavourful:category-bar', {
        items: category_items,
        count: recipe_count,
        label: 'Recipe categories'|t,
      }, with_context = false) }}
    {% endif %}

    {#
      The breadcrumb, below the strip — where the design puts the trail. The
      breadcrumb block renders its own <nav aria-label="Breadcrumb">, so
      nothing is added around it here.
    #}
    {{ page.breadcrumb }}

  </header>

  {{ page.highlighted }}

  {{ page.help }}

  {#
    No aria-label on <main>: there is only ever one main landmark on a page, so
    a label tells a screen reader nothing it does not already announce.
  #}
  <main class="page-main{{ is_bleed ? ' page-main--bleed' }}">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div class="layout-content">
      {{ page.content }}
    </div>{# /.layout-content #}

    {#
      Render each sidebar first and test the *markup*, not the render array.
      `{% if page.sidebar_second %}` is true whenever the region exists at all
      (a render array carries #cache and block metadata), so regions whose
      blocks produce no output still emitted an empty <aside> — an unnamed-but-
      present `complementary` landmark cluttering the landmark list on every
      page that has no sidebar content.
    #}
    {% set sidebar_first = page.sidebar_first|render %}
    {% if sidebar_first|trim is not empty %}
      <aside class="layout-sidebar-first" aria-label="{{ 'Recipe details'|t }}">
        {{ sidebar_first }}
      </aside>
    {% endif %}

    {% set sidebar_second = page.sidebar_second|render %}
    {% if sidebar_second|trim is not empty %}
      <aside class="layout-sidebar-second" aria-label="{{ 'Related content'|t }}">
        {{ sidebar_second }}
      </aside>
    {% endif %}

  </main>

  {#
    The footer band. Rendered whenever there is either a placed block or a
    footer menu link — the two are independent, and testing only `page.footer`
    would drop the whole designed strip on a site with no footer blocks.

    <footer> lives here rather than inside the component so there is exactly one
    contentinfo landmark.
  #}
  {% set footer_content = page.footer|render %}
  {% if footer_content|trim is not empty or footer_links is not empty %}
    <footer>
      {% embed 'flavourful:site-footer' with {
        links: footer_links,
        tagline: site_established,
        links_label: 'Footer'|t,
        footer_content: footer_content,
        recipes_url: recipes_url,
      } only %}
        {% block content %}
          {{ footer_content }}
        {% endblock %}

        {% block action %}
          {#
            The design's trailing "Subscribe" action. This site has no
            newsletter or contact form, so the slot carries the real onward
            action it does have instead of a button that goes nowhere.

            `recipes_url` is resolved in PageHooks behind an access check and is
            null when the recipes view is disabled, which is why it is tested
            rather than passed to url() here — url() throws on a missing route.
          #}
          {% if recipes_url %}
            {{ include('flavourful:button', {
              label: 'Browse all recipes'|t,
              url: recipes_url,
              variant: 'brass',
              size: 'sm',
            }, with_context = false) }}
          {% endif %}
        {% endblock %}
      {% endembed %}
    </footer>
  {% endif %}

</div>{# /.layout-container #}
