{#
/**
 * @file
 * Theme override for a views mini-pager.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - pagination_heading_level: The heading level to use for the pager.
 * - items: List of pager items.
 *
 * @see template_preprocess_views_mini_pager()
 */
#}
{% if items.previous or items.next %}
  <nav class="pager" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="pager__heading visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items js-pager__items">
      {% if items.previous %}
        <li class="pager__item pager__item--previous">
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
            <span aria-hidden="true">{{ items.previous.text|default('‹‹'|t) }}</span>
          </a>
        </li>
      {% endif %}
      {#
        The current page is text rather than a link, which is correct — there
        is nowhere to navigate to — but it left the mini pager with no
        programmatic current-page marker at all. aria-current="page" is valid
        on any element, not only on links, and this is the element that means
        "you are here".

        `total_pages` comes from \Drupal\flavourful\Hook\ListingHooks. Core's
        mini pager knows only the current number, so "Page 2" alone gives no
        sense of how far through the set you are; "Page 2 of 7" does. It falls
        back to the bare number when the total is unavailable.
      #}
      {% if items.current %}
        <li class="pager__item is-active" aria-current="page">
          {% if total_pages %}
            {% trans %}
              Page {{ items.current }} of {{ total_pages }}
            {% endtrans %}
          {% else %}
            {% trans %}
              Page {{ items.current }}
            {% endtrans %}
          {% endif %}
        </li>
      {% endif %}

      {% if items.next %}
        <li class="pager__item pager__item--next">
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            <span aria-hidden="true">{{ items.next.text|default('››'|t) }}</span>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
