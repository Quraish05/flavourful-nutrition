{#
/**
 * @file
 * Recipe — full node page.
 *
 * Composes the designed page out of components: the split hero (image beside
 * the text column), the chef byline, the spec strip, the interactive
 * ingredients/method, the pairing note and the tag row. Every scalar comes from
 * src/Hook/RecipeHooks.php, so this template is a layout, not a query.
 *
 * ── Site Studio ────────────────────────────────────────────────────────────
 * When Site Studio (Cohesion) owns a content template for the recipe bundle,
 * its template takes over this view mode and nothing below renders. That is a
 * configuration question, not a code one: check
 * /admin/cohesion/templates/content_templates for an enabled recipe template.
 * The teaser view mode is unaffected either way.
 *
 * Available variables — the full list from core's node.html.twig applies; the
 * ones this template uses are:
 * - node: The node entity, with limited access to object properties.
 * - label: The title of the node.
 * - content: All node items, so `content|without(...)` can render the remainder.
 * - url: Direct URL of the current node.
 * - page: TRUE when rendered as its own page (rather than embedded).
 * - attributes, title_prefix, title_suffix: as core documents them.
 *
 * Added by src/Hook/RecipeHooks.php:
 * - recipe_eyebrow: the cuisine label above the headline.
 * - recipe_meta: the meta-list rows (chef, total time, difficulty).
 * - recipe_spec: the spec-strip rows (total, prep, cook, level).
 * - recipe_tags: tag-pill rows from the diet and ingredient terms.
 * - recipe_ingredients, recipe_steps: rows for the recipe-tools organism.
 *   Both are empty on the current content model — see the note below.
 * - chef_name, chef_url: the byline.
 * - is_quick: total time is 30 minutes or under.
 *
 * @see template_preprocess_node()
 * @see \Drupal\flavourful\Hook\RecipeHooks
 */
#}
{{ attach_library('flavourful/recipes') }}

<article{{ attributes.addClass('recipe-page', page ? 'recipe-page--bleed') }}>

  {{ title_prefix }}

  {#
    The hero. `split` sets the image beside the text column, as the design does.

    heading_level is 1 when this is the page — the hero's headline *is* the page
    heading, and this template is why the page-title block is hidden on recipe
    nodes. Embedded (page is FALSE, e.g. in a search result), it drops to 2 and
    keeps the title a link.
  #}
  {#
    `|filter(v => v is not null)`: SDC rejects an explicitly-passed null for a
    prop declared `type: string`, so the nulls this content model produces
    (no cuisine term, no chef) are dropped rather than guarded field by field.
    See the same note in node--recipe--teaser.html.twig — including why every
    value here comes from RecipeHooks rather than from `node.field_*`.
  #}
  {% embed 'flavourful:hero-feature' with {
    title: label,
    heading_level: page ? 1 : 2,
    url: page ? null : url,
    eyebrow: recipe_eyebrow,
    summary: recipe_summary,
    meta: recipe_meta,
    layout: 'split',
    hero_media: content.field_hero,
    spec: recipe_spec,
    chef_name: chef_name,
    chef_url: chef_url,
    chef_picture: content.field_chef,
    ingredients: recipe_ingredients,
    steps: recipe_steps,
    is_quick: is_quick,
  }|filter(v => v is not null) only %}

    {% block caption %}
      {#
        The design's photo credit. There is no credit field, so the image's own
        alt text is not repurposed for it — that would put the same words in the
        accessibility tree twice. The slot stays empty until a field exists.
      #}
    {% endblock %}

    {% block media %}
      {% if hero_media|render|trim is not empty %}
        {{ hero_media }}
      {% else %}
        <span class="recipe-card__placeholder" aria-hidden="true">◍</span>
      {% endif %}
    {% endblock %}

    {% block media_overlay %}
      {#
        The design's "Editor's pick" chip. There is no editorial-flag field, so
        the one real distinction this content model can make stands in: a recipe
        that is genuinely quick to cook.
      #}
      {% if is_quick %}
        {{ include('flavourful:tag-pill', {
          label: 'Under 30 minutes'|t,
          variant: 'brass',
        }, with_context = false) }}
      {% endif %}
    {% endblock %}

    {% block aside %}
      {#
        The byline sits under the meta row in the design. It is rendered here
        rather than folded into `meta` because it carries an avatar and a
        rating, which a flat meta list cannot hold.
      #}
      {% if chef_name %}
        {% embed 'flavourful:chef-byline' with {
          name: chef_name,
          url: chef_url,
          picture: chef_picture,
        }|filter(v => v is not null) only %}
          {% block avatar %}
            {#
              field_chef renders as a link to the chef node, not a portrait —
              there is no image field on the chef type. Left empty so the
              component's ruled placeholder circle shows, which is what the
              design does for a chef with no photo.
            #}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {% if spec is not empty %}
        {{ include('flavourful:spec-table', {
          items: spec,
          label: 'Recipe at a glance'|t,
        }, with_context = false) }}
      {% endif %}

      {#
        Ingredients, method, servings scaler and Cook Mode. Renders nothing
        unless the recipe has method steps — and the current content model has
        no ingredient-row or method-step field at all, so on this site it is
        silent. RecipeHooks reads field_ingredient_rows / field_method_steps by
        name, so adding those two fields to the recipe type is all it takes.
      #}
      {% if steps is not empty or ingredients is not empty %}
        {{ include('flavourful:recipe-tools', {
          base_servings: 4,
          ingredients: ingredients,
          steps: steps,
          heading_level: 2,
        }, with_context = false) }}
      {% else %}
        {#
          No structured method to show. field_summary is the only prose the
          recipe has and the hero already prints it, so nothing is repeated
          here — an empty "Method" heading would be worse than no heading.
        #}
      {% endif %}
    {% endblock %}

  {% endembed %}

  <div class="recipe-page__body">

    {#
      An extension point for the per-cuisine templates. flavourful_nutrition's
      hook_theme_suggestions_node_alter() adds a `node--recipe--<cuisine>`
      suggestion for the full view mode, and those templates `{% extends %}`
      this one and fill this block — so an Italian recipe gets its own editorial
      note without a second copy of this whole layout going stale beside it.

      @see templates/content/node--recipe--italian.html.twig
    #}
    {% block cuisine_note %}{% endblock %}

    {#
      The tag row. Each chip links to its term page, so the row is a way into
      the related listings rather than decoration.
    #}
    {% if recipe_tags is not empty %}
      <div class="recipe-page__tags">
        {% for tag in recipe_tags %}
          {{ include('flavourful:tag-pill', {
            label: tag.label,
            url: tag.url,
          }, with_context = false) }}
        {% endfor %}
      </div>
    {% endif %}

    {#
      Whatever the node's display adds that is not placed above: extra fields, a
      contributed module's output, comments. Rendered with `without` so nothing
      appears twice — the fields listed here are all already on the page.

      Kept rather than dropped because silently swallowing a field an editor has
      just enabled is the worst kind of theme bug to debug.
    #}
    {% set rest = content|without(
      'field_hero',
      'field_summary',
      'field_chef',
      'field_recipe_cuisine_type',
      'field_type_of_diet',
      'field_recipe_ingredients',
      'field_difficulty',
      'field_prep_time',
      'field_cooking_time',
      'field_total_time'
    ) %}
    {% if rest|render|trim is not empty %}
      <div{{ content_attributes.addClass('recipe-page__rest') }}>
        {{ rest }}
      </div>
    {% endif %}

    {#
      author_name and date are already-rendered markup (a user link, a <time>
      element), so they are printed rather than passed through t() as
      placeholders — t() escapes placeholder values, which would print the
      markup as visible text.
    #}
    {% if display_submitted %}
      <p class="recipe-page__submitted">
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
      </p>
    {% endif %}

  </div>

  {{ title_suffix }}

</article>
