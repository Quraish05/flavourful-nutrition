<?php

/**
 * @file
 * Theme hooks for the Flavourful theme.
 */

use Drupal\Core\Form\FormStateInterface;

/** Stash the view's title on the exposed form; the render array does not carry the view itself. */
function flavourful_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if ($view) {
    $form['#view_label'] = $view->getTitle() ?: $view->storage->label();
  }
}

/** Lift that label into a template variable so the exposed-form template can name its own fieldset. */
function flavourful_preprocess_views_exposed_form(array &$variables): void {
  $variables['filter_label'] = $variables['form']['#view_label'] ?? NULL;
}
