{#
/**
 * @file
 * Recipe tools: servings scaler + Cook Mode.
 *
 * Props:
 * - base_servings: int — the yield the amounts are written for (default 4).
 * - ingredients: list of { qty?, unit?, name } — qty omitted for non-numeric rows.
 * - steps: list of strings — the method, one step each.
 *
 * Progressive enhancement: everything here is meaningful without JS. The
 * flavourful/recipe-tools library adds live scaling and the Cook Mode overlay;
 * the Cook Mode button is hidden until JS reveals it.
 */
#}
<section class="recipe-tools" data-recipe-tools data-base-servings="{{ base_servings|default(4) }}">
  <div class="recipe-tools__bar">
    <div class="recipe-tools__servings" role="group" aria-label="{{ 'Servings'|t }}">
      <button type="button" class="recipe-tools__step-btn" data-servings-dec aria-label="{{ 'Fewer servings'|t }}">&minus;</button>
      <span class="recipe-tools__servings-label">
        <output class="recipe-tools__servings-value" data-servings>{{ base_servings|default(4) }}</output>&nbsp;{{ 'servings'|t }}
      </span>
      <button type="button" class="recipe-tools__step-btn" data-servings-inc aria-label="{{ 'More servings'|t }}">+</button>
    </div>
    {% if steps is not empty %}
      <button type="button" class="recipe-tools__cook-btn" data-cook-start hidden>{{ '👩‍🍳 Cook mode'|t }}</button>
    {% endif %}
  </div>

  {% if ingredients is not empty %}
    <ul class="recipe-tools__ingredients">
      {% for ing in ingredients %}
        <li class="recipe-tools__ingredient">
          {% if ing.qty is defined %}
            <span class="recipe-tools__qty" data-qty="{{ ing.qty }}" data-unit="{{ ing.unit|default('') }}">{{ ing.qty }}{{ ing.unit|default('') }}</span>
          {% endif %}
          <span class="recipe-tools__name">{{ ing.name }}</span>
        </li>
      {% endfor %}
    </ul>
    <p class="recipe-tools__note" data-scale-note hidden aria-live="polite"></p>
  {% endif %}

  {% if steps is not empty %}
    <div class="recipe-tools__cook" data-cook-panel hidden>
      <div class="recipe-tools__cook-inner">
        <button type="button" class="recipe-tools__cook-close" data-cook-end aria-label="{{ 'Exit cook mode'|t }}">&times;</button>
        <p class="recipe-tools__progress" data-cook-progress aria-live="polite"></p>
        <ol class="recipe-tools__steps">
          {% for step in steps %}
            <li class="recipe-tools__step" data-step>{{ step }}</li>
          {% endfor %}
        </ol>
        <div class="recipe-tools__cook-nav">
          {{ include('flavourful:action-button', {
            label: '← Previous'|t,
            variant: 'plain',
            attributes: create_attribute({ 'data-cook-prev': true }).addClass('recipe-tools__nav-btn'),
          }) }}
          {{ include('flavourful:action-button', {
            label: 'Next →'|t,
            variant: 'plain',
            attributes: create_attribute({ 'data-cook-next': true }).addClass('recipe-tools__nav-btn'),
          }) }}
        </div>
      </div>
    </div>
  {% endif %}
</section>
