{#
/**
 * @file
 * Action button atom. See action-button.component.yml for the props contract.
 *
 * Renders a real <button type="button"> (not a link). Callers attach behaviour
 * hooks and state through the attributes object, e.g.:
 *   include('flavourful:action-button', {
 *     label: 'Next'|t,
 *     attributes: create_attribute({ 'data-cook-next': true }),
 *   })
 *
 * Every variant except "plain" borrows the button atom's own .btn/.btn--* rules
 * instead of duplicating them, so an action and a link with the same variant
 * cannot drift apart. "plain" opts out entirely for host-styled contexts.
 #}
{% set variant = variant|default('plain') %}
{% set styled = variant != 'plain' %}
<button
  type="button"
  {{ attributes.addClass(
    'btn-action',
    'btn-action--' ~ variant,
    styled ? 'btn' : null,
    styled ? 'btn--' ~ variant : null,
    styled ? 'btn--' ~ size|default('md') : null
  ) }}>{{ label }}</button>
