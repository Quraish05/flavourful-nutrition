{#
/**
 * @file
 * Rating stars atom. See rating-stars.component.yml for the props contract.
 *
 * `value` is required, so there is no "no rating" branch here. Whether an item
 * has a rating is the caller's question — both callers already guard on
 * `rating is not null` — and answering it twice would mean the schema said
 * required while the template quietly tolerated nothing.
 *
 * The guard this replaced also read `value > 0`, which silently dropped a
 * genuine rating of 0. Zero is a real score and renders as five empty stars.
 */
#}
{% set max = max|default(5) %}
{# Round to the nearest half so a 4.6 shows four filled and one half star. #}
{% set halves = (value * 2)|round %}

<span{{ attributes.addClass('rating') }}>
  {#
    The glyph row is decorative. Everything it conveys is in the sentence
    below it, so it is removed from the accessibility tree rather than read
    out star by star.
  #}
  <span class="rating__stars" aria-hidden="true">
    {% for i in 1..max %}
      {% set filled = halves >= i * 2 %}
      {% set half = not filled and halves == (i * 2 - 1) %}
      <span class="rating__star{{ filled ? ' is-full' : (half ? ' is-half') }}">★</span>
    {% endfor %}
  </span>

  {% if show_value %}
    <span class="rating__value" aria-hidden="true">{{ value|number_format(1) }}</span>
  {% endif %}

  {#
    One sentence, one announcement. `count` folds into the same string so a
    screen reader does not hear the rating and the tally as two disconnected
    fragments.
  #}
  <span class="visually-hidden">
    {% if count %}
      {{ 'Rated @value out of @max by @count cooks'|t({
        '@value': value|number_format(1),
        '@max': max,
        '@count': count,
      }) }}
    {% else %}
      {{ 'Rated @value out of @max'|t({ '@value': value|number_format(1), '@max': max }) }}
    {% endif %}
  </span>
</span>

{% if count %}
  <span class="rating__count" aria-hidden="true">{{ '@count cooked it'|t({ '@count': count }) }}</span>
{% endif %}
